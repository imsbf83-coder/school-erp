// School ERP Database Schema
// Works with SQLite (local dev) or PostgreSQL (production/cloud)
// Switch provider below when deploying — see README.
//
// Note: fields that represent a fixed set of choices (role, status, gender,
// category, etc.) are stored as String rather than Prisma `enum`, because
// Prisma's enum support does not work with the SQLite provider used for
// local development. The allowed values for each are documented in a
// comment above the field, and are enforced by the API layer
// (express-validator's .isIn(...) checks in the route files).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // was "sqlite" - switched for cloud deployment; set DATABASE_URL to your Neon connection string
  url      = env("DATABASE_URL")
}

// ---------- AUTH / USERS ----------

model User {
  id           Int      @id @default(autoincrement())
  name         String
  // Nullable + unique: ADMIN/ACCOUNTANT/STAFF accounts still log in with
  // email. TEACHER accounts created via the Teacher Access module log in
  // with `phone` instead (see below) and generally won't have this set.
  email        String?  @unique
  // Mobile number login identifier. Required for TEACHER accounts created
  // via the Teacher Access module (sourced from the linked Staff record —
  // see Staff.phone below); optional/unused for other roles.
  phone        String?  @unique
  passwordHash String
  // One of: ADMIN, TEACHER, ACCOUNTANT, STAFF
  role         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // If this user account belongs to a staff member
  staff Staff?

  // Audit trail
  attendanceMarkedBy  AttendanceRecord[] @relation("MarkedBy")
  busExpensesRecorded BusExpense[]       @relation("BusExpenseRecordedBy")
  holidaysCreated     Holiday[]

  // Classes this user (role === TEACHER) has been given access to.
  // Empty for every other role — see utils/classAccess.js.
  teacherClasses TeacherClass[]

  // Module-level access grants for this user (STAFF/ACCOUNTANT accounts,
  // and optionally a TEACHER account with extra duties beyond their own
  // classes) — see utils/permissions.js.
  permissions StaffPermission[]
}

// Join table: which class(es) a TEACHER user is scoped to. A row here means
// "this user can see/manage this class's students, attendance, and exam
// results" — see utils/classAccess.js#getAllowedClassIds, which is the one
// place that turns this table into an access decision.
model TeacherClass {
  id      Int     @id @default(autoincrement())
  userId  Int
  user    User    @relation(fields: [userId], references: [id])
  classId Int
  class   Class   @relation(fields: [classId], references: [id])
  // Optional: scopes this teacher's access to one section of the class
  // (e.g. "A") rather than every section. Null means "the whole class".
  section String?

  createdAt DateTime @default(now())

  @@unique([userId, classId])
  @@index([classId])
}

// Grants a non-admin staff account (role STAFF or ACCOUNTANT — TEACHER
// access is governed separately by TeacherClass/classAccess.js) access to
// one module of the app. A user's full access is the UNION of every module
// row they have here. There is no ADMIN row ever needed — requirePermission
// in utils/permissions.js always lets role === 'ADMIN' through first,
// before even checking this table.
//
// `module` is one of a fixed set of string constants (see
// utils/permissions.js MODULES) — enforced at the API layer like every
// other "fixed choice" string field in this schema, not a DB enum, for the
// same SQLite-compatibility reason documented at the top of this file.
//
// Checked LIVE on every request (not baked into the JWT), so an admin
// revoking or granting a module takes effect on that user's very next
// request — no re-login required.
model StaffPermission {
  id     Int    @id @default(autoincrement())
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module String // one of: STUDENTS, ATTENDANCE, EXAMS, ADMISSIONS, BUS, STAFF, CLASSES, GRADE_SCALES, HOLIDAYS

  createdAt DateTime @default(now())

  @@unique([userId, module])
  @@index([userId])
}

// ---------- STUDENTS ----------

model Student {
  id              Int      @id @default(autoincrement())
  admissionNumber String   @unique
  firstName       String
  lastName        String
  dateOfBirth     DateTime
  // One of: MALE, FEMALE, OTHER
  gender          String
  photoUrl        String?

  // Contact & family info
  address          String?
  phone            String?
  email            String?
  guardianName     String // Father Name
  guardianPhone    String?
  guardianEmail    String?
  guardianRelation String?
  fatherCnic       String? // Father's CNIC number
  bFormNumber      String? // Child's B-Form (NADRA) number
  religion         String?

  // Elective science group for grades that split into streams (typically
  // 9th/10th, Matric level). One of: COMPUTER, BIOLOGY — null/empty if not
  // applicable to this student's class.
  studentGroup String?

  // One of: NONE, SINGLE, DOUBLE — SINGLE = one parent deceased,
  // DOUBLE = both parents deceased. Often relevant for fee waivers.
  orphanStatus String? @default("NONE")

  // Academic placement
  classId    Int
  class      Class   @relation(fields: [classId], references: [id])
  section    String?
  rollNumber String?

  // REGULAR = currently enrolled, appears in class lists.
  // STRUCK_OFF / SLC / PASSOUT = exit statuses, each with its own report;
  // none of them appear in the day-to-day class list.
  status String @default("REGULAR")

  // Bus service (optional - only set if the student uses the school bus)
  busRouteId           Int?
  busRoute             BusRoute? @relation(fields: [busRouteId], references: [id])
  busPickupPoint       String?
  // Standing monthly discount off this rider's bus fee — set by hand, and
  // used to pre-fill the discount on each month's payment. Null/0 = none.
  busFeeDiscount       Float?
  // Why the standing discount was given. One of: SIBLING, PREPAYMENT,
  // ORPHAN, OTHER.
  busFeeDiscountReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Set when this student's row was created via re-admission (a student
  // who previously left — Struck Off / SLC / Passout — rejoining with a
  // brand new admission number). Points at their OLD Student row, whose
  // attendance/exam history stays exactly where it was — nothing is moved
  // or merged, this is purely a traceable link between the two records.
  previousStudentId Int?
  previousStudent   Student?  @relation("Readmission", fields: [previousStudentId], references: [id])
  // The reverse side: if THIS student was later re-admitted under a new
  // admission number, this points at that new row. Empty unless that has
  // happened.
  readmittedAs      Student[] @relation("Readmission")

  admission      Admission?
  withdrawal     Withdrawal?
  attendance     AttendanceRecord[]
  examResults    ExamResult[]
  busFeePayments BusFeePayment[]

  @@index([classId])
  @@index([status])
  @@index([busRouteId])
}

model Class {
  id       Int     @id @default(autoincrement())
  name     String  @unique // e.g. "Grade 6"
  sections String? // e.g. "A,B,C" stored as CSV for simplicity

  students     Student[]
  examClasses  ExamClass[]
  teacherLinks TeacherClass[]
}

// ---------- HOLIDAYS ----------
// School-wide non-working days (occasional closures, summer vacation days,
// Eid holidays, etc.) declared once here instead of being re-marked in
// every class's daily attendance. Saturdays and Sundays are treated as
// weekly holidays automatically by the API and are not stored as rows here.
model Holiday {
  id   Int      @id @default(autoincrement())
  date DateTime @unique
  name String // e.g. "Eid-ul-Fitr", "Summer Vacation", "Independence Day"

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([date])
}

// ---------- ADMISSION / WITHDRAWAL ----------

model Admission {
  id                Int      @id @default(autoincrement())
  studentId         Int      @unique
  student           Student  @relation(fields: [studentId], references: [id])
  admissionDate     DateTime @default(now())
  academicYear      String // e.g. "2026-2027"
  previousSchool    String?
  documentsReceived String? // CSV list of documents e.g. "Birth Certificate,Transfer Certificate"
  remarks           String?

  formDetail AdmissionFormDetail?
}

// Every field on the FDE (Federal Directorate of Education) student
// admission form that isn't already covered by Student/Admission — e.g.
// firstName/lastName/gender/dateOfBirth/classId/section, guardianName
// (= "Father's Name"), guardianPhone, guardianEmail, fatherCnic,
// bFormNumber, religion, phone, email, address, orphanStatus, studentGroup,
// admissionNumber, academicYear, previousSchool and documentsReceived all
// already exist on Student/Admission and are deliberately NOT duplicated
// here. This table is optional per admission (1:1, nullable) — filling it
// in is not required to record an admission.
model AdmissionFormDetail {
  id          Int       @id @default(autoincrement())
  admissionId Int       @unique
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  // ---- 1. Personal details ----
  cnicOrFormAvailable Boolean?
  // One of: PUNJAB, BALOCHISTAN, SINDH, KPK, ICT, GILGIT_BALTISTAN, AJK
  provinceOfBirth       String?
  districtOfBirth       String?
  receivingGirlsStipend Boolean? // only meaningful for girls
  // One of: PAKISTANI, OTHER
  nationality      String? @default("PAKISTANI")
  nationalityOther String?
  domicileDistrict String? // only if Pakistani
  // Only if Pakistani. Same options as provinceOfBirth.
  domicileProvince String?

  // Permanent address
  // One of: SECTOR, HOUSING_SOCIETY, VILLAGE, OTHERS
  permanentAddressType   String?
  permanentAddressDetail String? // sector/sub-sector, housing society, or village name
  permanentHouseNo       String?
  permanentStreetNo      String?
  whatsappNumber         String?

  // Present postal address
  presentCity          String?
  presentAddressType   String? // same options as permanentAddressType
  presentAddressDetail String?
  presentHouseNo       String?
  presentStreetNo      String?

  // One of: PASHTO, ENGLISH, SARAIKI, PUNJABI, BALTI, SHINA, URDU, HINDKO, SINDHI, BALOCHI
  motherLanguage String?
  // One of: A+, A-, AB+, AB-, O+, O-
  bloodGroup String?
  isHafiz    Boolean?

  // ---- 2. Parents / guardians ----
  fatherAlive Boolean?
  fatherLandline       String?
  fatherQualification  String?
  // One of: GOVT_EMPLOYEE, PRIVATE_EMPLOYEE, BUSINESSMAN, FARMER, OVERSEAS, OTHER
  fatherProfession      String?
  fatherProfessionOther String?
  fatherIncome          Float?
  fatherBps             String? // only if a Govt. Employee
  fatherDomicileProvince String?
  fatherDomicileDistrict String?

  motherName          String?
  motherAlive         Boolean?
  motherCnic          String?
  motherContactNumber String?
  motherLandline      String?
  motherEmail         String?
  motherQualification String?
  motherProfession      String? // same options as fatherProfession
  motherProfessionOther String?
  motherIncome          Float?
  motherBps             String?

  // Filled when the student is an orphan (Student.orphanStatus = SINGLE or
  // DOUBLE already records which); this is the responsible guardian's info.
  orphanGuardianContact        String?
  orphanGuardianEmail          String?
  orphanGuardianQualification  String?
  orphanGuardianProfession     String?
  orphanGuardianProfessionOther String?
  orphanGuardianIncome         Float?
  orphanGuardianBps            String?

  // ---- 3. Educational details ----
  classGroupFde             String? // grades 9-12 stream, as written on the FDE form (kept separate from Student.studentGroup used by exam grading)
  resultPercentageLastClass String?
  lastInstitutionUnderFde   String?
  lastInstitutionOther      String? // last institution attended, other than FDE
  // One of: MORNING, EVENING
  shift                  String?
  availingMealProgram    Boolean?
  // One of: URDU, ENGLISH
  mediumOfInstruction    String?
  yearsToCompletePrimary Int?
  // One of: DAY_SCHOLAR, BOARDER
  modeOfStudy            String?

  totalSiblings                  Int?
  siblingsInOtherFdeInstitutions Int?
  siblingsInSameInstitution      Int?
  siblingsInPrivateInstitutions  Int?

  // One of: INSTITUTION_BUS, PRIVATE, NONE — declarative, for the compliance
  // form only. Actual bus billing still runs through Student.busRouteId.
  transportFacility String?

  isScholarshipRecipient   Boolean?
  scholarshipDetails       String?
  hasCoCurricularAchievement Boolean?
  achievementDetails       String?

  // ---- 4. Emergency contact ----
  emergencyContactName    String?
  emergencyContactNumber  String?
  // One of: FATHER, MOTHER, SISTER, BROTHER, AUNT, UNCLE, OTHER
  emergencyContactRelation      String?
  emergencyContactRelationOther String?

  // ---- 5. IDP details ----
  isRefugeeOrIdp     Boolean?
  isRegisteredRefugee Boolean?
  idpStatus           String?
  refugeeCardNumber   String?

  // ---- 6. Health details ----
  hasMajorDisability Boolean?
  disabilityCertificateAttached Boolean?
  // One of: PHYSICAL, VISUAL, HEARING, INTELLECTUAL, MULTIPLE, OTHER
  disabilityType String?

  hasMentalDisability Boolean?
  // One of: AUTISM, ADHD, OTHER
  mentalDisabilityType String?

  otherMedicalConditions String?

  isVisuallyFit6by6 Boolean?
  wearsGlasses      Boolean?
  // One of: NO_DIFFICULTY, SOME_DIFFICULTY, A_LOT_OF_DIFFICULTY, CANNOT_DO_AT_ALL
  difficultySeeingBoard String?

  hasHearingDifficulty    Boolean?
  usesHearingAid          Boolean?
  hearingDifficultyDetails String?
  difficultyListening      Boolean?

  difficultyWalking     Boolean?
  usesCrutchesOrWalker  Boolean?

  // Same NO_DIFFICULTY..CANNOT_DO_AT_ALL scale as difficultySeeingBoard
  difficultyReadingWriting String?
  difficultyRemembering    String?
  difficultyConcentrating  String?

  basicVaccinationCompleted Boolean?

  // ---- 7. Digital access ----
  hasDigitalDeviceAtHome Boolean?
  digitalDeviceType      String?
  hasInternetAtHome      Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Withdrawal {
  id                 Int      @id @default(autoincrement())
  studentId          Int      @unique
  student            Student  @relation(fields: [studentId], references: [id])
  withdrawalDate     DateTime @default(now())
  // The exit status applied to the student. One of: STRUCK_OFF, SLC, PASSOUT
  status             String
  reason             String
  transferCertIssued Boolean  @default(false)
  remarks            String?
}

// ---------- ATTENDANCE ----------

model AttendanceRecord {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  date      DateTime
  // One of: PRESENT, ABSENT, LATE, EXCUSED
  status    String
  remarks   String?

  markedById Int?
  markedBy   User? @relation("MarkedBy", fields: [markedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([studentId, date]) // one record per student per day
  @@index([date])
}

// ---------- EXAMINATION ----------

model Exam {
  id           Int      @id @default(autoincrement())
  name         String // e.g. "Mid-Term Exam"
  academicYear String
  startDate    DateTime
  endDate      DateTime

  // Which of the year's four terms this exam is. 1-3 are assessment only;
  // 4 is the final term, which additionally decides promotion using the
  // two thresholds below. Null on exams created before terms existed.
  term              Int?
  // Percentage a student must score in a subject to pass it. Applied to
  // each subject's own maxMarks, so it survives max marks changing between
  // terms. ExamSubject.passMarks holds the same threshold in raw marks,
  // for display only — see utils/examGrading.js.
  passPercent       Float  @default(40)
  // Final term only. Both must be set for a promotion status to be
  // calculated, and both must be satisfied for a student who failed at
  // least one subject to still be promoted.
  maxFailedSubjects Int?
  minOverallPercent Float?

  // The class(es) this exam is held for. A single exam can now cover
  // several classes at once (e.g. "9A", "9B", "9C" all sitting the same
  // Mid-Term paper) instead of needing one exam per class.
  classes ExamClass[]

  subjects ExamSubject[]
}

// Join table: which classes a given exam is held for.
model ExamClass {
  id       Int     @id @default(autoincrement())
  examId   Int
  exam     Exam    @relation(fields: [examId], references: [id])
  classId  Int
  class    Class   @relation(fields: [classId], references: [id])
  // Which sections of that class sit this exam, e.g. "A,B" stored as CSV —
  // same idiom as Class.sections. Null (or empty) means "the whole class",
  // which is how every exam created before this field existed behaves.
  sections String?

  @@unique([examId, classId])
}

model ExamSubject {
  id          Int    @id @default(autoincrement())
  examId      Int
  exam        Exam   @relation(fields: [examId], references: [id])
  subjectName String
  maxMarks    Float  @default(100)
  // The pass threshold in raw marks — Exam.passPercent of maxMarks, stored
  // unrounded so it always agrees with the percentage test. Display only:
  // pass/fail is decided on the percentage (see utils/examGrading.js).
  passMarks   Float  @default(33)
  // Who sits this subject. One of: ALL, MUSLIM, NON_MUSLIM,
  // GROUP_COMPUTER, GROUP_BIOLOGY. Anything other than ALL makes the
  // subject an elective, so it counts toward the totals of only those
  // students — Muslim students sit ISL/THQ while non-Muslim students sit
  // IKH/CHR, and a 9-10 student sits either C.SCI or BIO.
  appliesTo   String @default("ALL")
  // Restricts the subject to one grade within the exam's classes — e.g. PST
  // sat only by grade 10, ISL/THQ/IKH/CHR only by grade 9, in a 9-10 exam.
  // Null means "every grade this exam covers", which is how every subject
  // behaved before this existed.
  gradeOnly   Int?
  // Display order, so the subject list keeps the school's own sequence
  // regardless of insert order.
  sortOrder   Int    @default(0)

  results ExamResult[]
}

model ExamResult {
  id            Int         @id @default(autoincrement())
  studentId     Int
  student       Student     @relation(fields: [studentId], references: [id])
  examSubjectId Int
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id])
  marksObtained Float
  grade         String?
  remarks       String?

  @@unique([studentId, examSubjectId])
}

// ---------- GRADING SCALE ----------
// The percentage -> grade table. Editable in the app (Examinations ->
// Grading scale) rather than hardcoded, because different grade ranges can
// mark differently. One scale with no range set is the fallback used by any
// class that has no more specific scale.
model GradeScale {
  id       Int    @id @default(autoincrement())
  name     String @unique // e.g. "Default (all classes)", "Classes 9-10"
  // Inclusive range of grade numbers this scale applies to, matched against
  // the number parsed out of Class.name ("9" -> 9, "Grade 10" -> 10). Both
  // null means "any class" — the fallback scale, which must always exist.
  minGrade Int?
  maxGrade Int?

  bands GradeBand[]

  createdAt DateTime @default(now())
}

// One row of the scale: "90% and above is an A+, worth 6 points,
// 'Outstanding'". Bands are matched highest-minPercent-first, so the bounds
// are inclusive and exactly 40% is the lowest passing grade.
model GradeBand {
  id           Int        @id @default(autoincrement())
  gradeScaleId Int
  gradeScale   GradeScale @relation(fields: [gradeScaleId], references: [id], onDelete: Cascade)
  grade        String // e.g. "A+"
  minPercent   Float // inclusive lower bound; one band must be 0
  gradePoint   Float // used for the GPA — 6 down to 0
  remarks      String? // e.g. "Outstanding", shown against the overall grade

  @@index([gradeScaleId])
}

// ---------- BUS SERVICE / FEE COLLECTION ----------

// The physical bus. Kept separate from BusRoute so that if the school
// reassigns which bus serves a route, this vehicle's maintenance history
// travels with IT, not with whichever route it happens to be serving.
model Vehicle {
  id            Int     @id @default(autoincrement())
  vehicleNumber String  @unique
  model         String? // e.g. "Toyota Coaster"
  capacity      Int?
  driverName    String?
  driverPhone   String?
  active        Boolean @default(true)
  notes         String?

  routes   BusRoute[] // route(s) currently served by this vehicle
  expenses BusExpense[] // full maintenance/repair history, independent of route changes

  createdAt DateTime @default(now())
}

model BusRoute {
  id         Int    @id @default(autoincrement())
  name       String // e.g. "Route 3 - Model Town"
  monthlyFee Float // default monthly fee for this route

  // The vehicle currently assigned to this route. Nullable because a route
  // can temporarily have no vehicle, and reassigning this does NOT move or
  // delete the previous vehicle's expense history.
  vehicleId Int?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  students   Student[]
  passengers BusPassenger[]
  payments   BusFeePayment[]

  createdAt DateTime @default(now())
}

// A bus rider who is NOT an enrolled student — e.g. a junior-section child
// too young to be admitted yet, or a sibling who only uses the bus.
// Deliberately separate from Student so bus-only riders never appear in
// class lists, attendance, or exam records.
model BusPassenger {
  id            Int     @id @default(autoincrement())
  name          String
  guardianName  String
  guardianPhone String
  note          String? // e.g. "Junior section - not yet enrolled", "Sibling of STU-0002"
  active        Boolean @default(true)

  busRouteId           Int
  busRoute             BusRoute @relation(fields: [busRouteId], references: [id])
  pickupPoint          String?
  // Standing monthly discount off this rider's bus fee — see the matching
  // fields on Student.
  busFeeDiscount       Float?
  // One of: SIBLING, PREPAYMENT, ORPHAN, OTHER
  busFeeDiscountReason String?

  payments BusFeePayment[]

  createdAt DateTime @default(now())
}

// A payment always belongs to exactly one rider — either an enrolled
// student OR a bus passenger, never both. Both FKs are optional here
// because Prisma has no polymorphic relation; the app layer enforces
// that exactly one is set on create.
model BusFeePayment {
  id Int @id @default(autoincrement())

  studentId Int?
  student   Student? @relation(fields: [studentId], references: [id])

  busPassengerId Int?
  busPassenger   BusPassenger? @relation(fields: [busPassengerId], references: [id])

  busRouteId Int
  busRoute   BusRoute @relation(fields: [busRouteId], references: [id])

  // The month this payment covers, e.g. "2026-08"
  month          String
  // The full route fee at the time of collection, before any discount.
  // Snapshotted so an old receipt still reconciles if BusRoute.monthlyFee
  // is later changed. Null on payments recorded before this field existed.
  grossFee       Float?
  // Discount applied to this month only. Pre-filled from the rider's
  // standing busFeeDiscount but editable per payment.
  discount       Float    @default(0)
  // One of: SIBLING, PREPAYMENT, ORPHAN, OTHER
  discountReason String?
  // What was actually received — i.e. already net of `discount`. Every
  // collection total in the reports sums this field, so it must stay net.
  amount         Float
  paymentDate    DateTime @default(now())
  // One of: CASH, BANK_TRANSFER, ONLINE, CHEQUE
  paymentMethod  String   @default("CASH")
  remarks        String?

  createdAt DateTime @default(now())

  @@unique([studentId, month]) // one payment per enrolled student per month
  @@unique([busPassengerId, month]) // one payment per bus passenger per month
  @@index([busRouteId, month])
}

model BusExpense {
  id        Int     @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  // One of: FUEL, REPAIR, MAINTENANCE, INSURANCE, PERMIT_OR_TAX, OTHER
  category        String
  description     String
  amount          Float
  expenseDate     DateTime @default(now())
  vendorName      String?
  odometerReading Int?
  remarks         String?

  recordedById Int?
  recordedBy   User? @relation("BusExpenseRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([vehicleId, expenseDate])
}

// ---------- STAFF ----------

model Staff {
  id         Int    @id @default(autoincrement())
  employeeId String @unique
  userId     Int?   @unique
  user       User?  @relation(fields: [userId], references: [id])

  firstName   String
  lastName    String
  dateOfBirth DateTime?
  // One of: MALE, FEMALE, OTHER
  gender      String?
  photoUrl    String?

  designation    String // e.g. "Mathematics Teacher", "Accountant"
  department     String?
  // One of: TEACHING, NON_TEACHING — determines the Employee ID prefix
  // (TCH- / STF-) when an ID is auto-generated rather than typed in.
  category       String   @default("NON_TEACHING")
  // One of: FULL_TIME, PART_TIME, CONTRACT
  employmentType String   @default("FULL_TIME")
  dateJoined     DateTime @default(now())
  // One of: ACTIVE, ON_LEAVE, RESIGNED, TERMINATED
  status         String   @default("ACTIVE")

  phone   String?
  email   String?
  address String?

  salary           Float?
  qualifications   String?
  emergencyContact String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
